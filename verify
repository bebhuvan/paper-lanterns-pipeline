#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

echo "==> [1/4] Checking git history for secrets (gitleaks $(cat .gitleaks-version))..."
gl_want="$(cat .gitleaks-version)"
gl_have="$(gitleaks version | tr -d 'v')"
if [[ "$gl_have" != "$gl_want" ]]; then
  echo "gitleaks $gl_have found, but .gitleaks-version pins $gl_want" >&2
  exit 1
fi
gitleaks git --redact --no-banner --exit-code 1 .

echo "==> [2/4] Running ruff check..."
uv run ruff check src tests

echo "==> [3/4] Running pytest..."
uv run pytest

echo "==> [4/4] Running lanterns doctor..."
uv run lanterns doctor

echo "==> ALL VERIFICATION GATES PASSED."
